import numpy as np

def ref(A):
    A = A.astype(float)
    n = A.shape[0]
    for i in range(n):
        for j in range(i + 1, n):
            factor = A[j, i] / A[i, i]
            A[j, i:] -= factor * A[i, i:]
    return A

A = np.random.randint(1, 10, size=(4, 4))
print("Original Matrix A:")
print(A)

print("\nMatrix in REF:")
print(ref(A))
