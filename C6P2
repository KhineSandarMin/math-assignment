import numpy as np
from scipy import linalg as la
import matplotlib.pyplot as plt

def problem_2(A):
    theta = np.linspace(0, 2 * np.pi, 200)
    S = np.array([np.cos(theta), np.sin(theta)])
    E = np.array([[1, 0, 0], [0, 0, 1]])
    
    U, s, Vh = la.svd(A)
    Sigma = np.diag(s)
    
    fig, axes = plt.subplots(2, 2, figsize=(10, 10))
    
    axes[0, 0].plot(S[0], S[1], lw=2)
    axes[0, 0].plot(E[0], E[1], lw=2)
    axes[0, 0].set_title("(a) S")
    axes[0, 0].axis("equal")
    
    VhS = Vh @ S
    VhE = Vh @ E
    axes[0, 1].plot(VhS[0], VhS[1], lw=2)
    axes[0, 1].plot(VhE[0], VhE[1], lw=2)
    axes[0, 1].set_title("(b) V^H S")
    axes[0, 1].axis("equal")
    
    SigVhS = Sigma @ VhS
    SigVhE = Sigma @ VhE
    axes[1, 0].plot(SigVhS[0], SigVhS[1], lw=2)
    axes[1, 0].plot(SigVhE[0], SigVhE[1], lw=2)
    axes[1, 0].set_title("(c) Sigma V^H S")
    axes[1, 0].axis("equal")
    
    USigVhS = U @ SigVhS
    USigVhE = U @ SigVhE
    axes[1, 1].plot(USigVhS[0], USigVhS[1], lw=2)
    axes[1, 1].plot(USigVhE[0], USigVhE[1], lw=2)
    axes[1, 1].set_title("(d) U Sigma V^H S")
    axes[1, 1].axis("equal")
    
    plt.tight_layout()
    plt.show()
    
    print("Matrix A:")
    print(A)
    print("Singular values (s):")
    print(s)
    print("Matrix U:")
    print(U)
    print("Matrix Vh:")
    print(Vh)

A = np.array([[3, 1], [1, 3]])
problem_2(A)
