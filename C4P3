import numpy as np
from scipy import linalg as la
import matplotlib.pyplot as plt

np.random.seed(42)
years = np.linspace(0, 10, 30)
index = 0.5 * years**3 - 5 * years**2 + 20 * years + 130 + np.random.normal(0, 3, size=years.shape)

mock_housing_data = np.column_stack((years, index))
np.save("housing.npy", mock_housing_data)

def problem_3():

    year, index = np.load("housing.npy").T
    degrees = [3, 6, 9, 12]
    
    year_fine = np.linspace(year.min(), year.max(), 500)
    
    fig, axes = plt.subplots(2, 2, figsize=(12, 10))
    axes = axes.flatten()
    
    for i, deg in enumerate(degrees):
        A = np.vander(year, deg + 1)
        b = index
        
        coeffs = la.lstsq(A, b)[0]
        
        print(f"--- Polynomial Coefficients (Degree {deg}) ---")
        print(coeffs)
        print()
        
        A_fine = np.vander(year_fine, deg + 1)
        fit_fine = A_fine @ coeffs
        
        ax = axes[i]
        ax.scatter(year, index, color="black", marker=",", label="Data Points")
        ax.plot(year_fine, fit_fine, color="red", linewidth=2, label=f"Degree {deg} Fit")
        ax.set_title(f"Polynomial Degree {deg}")
        ax.set_xlabel("Year (0 = 2000)")
        ax.set_ylabel("Housing Price Index")
        ax.legend()
        ax.grid(True, linestyle="--", alpha=0.6)
        
    plt.tight_layout()
    plt.show()
